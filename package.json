{
  "name": "bowenkliu.com",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --port 7999",
    "build": "next build --webpack && node scripts/prepare-export.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "predeploy": "yarn lint && yarn build && yarn test",
    "deploy": "gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "next": "16.3.4",
    "normalize.css": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "gh-pages": "6.3.0",
    "sass": "1.104.0",
    "typescript": "^5.9.3"
  }
}
